{
  "name": "@symplist/desktop",
  "productName": "Symplist",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Symplist on the desktop: the Next.js frontend in Electron, with the cloud session held in the main process.",
  "author": "Tejas Parthasarathi Sudarshan (https://tejassuds.com)",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/stage-web.mjs",
