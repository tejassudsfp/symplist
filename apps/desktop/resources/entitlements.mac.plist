<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The hardened runtime refuses a JIT and refuses unsigned executable memory, and V8 needs both. Without
  these two, a signed Symplist crashes the moment the renderer starts — which looks like a broken build
  rather than a signing problem, so they are here from the first signed build rather than after one.

  Nothing else is requested. The app opens no camera, no microphone, no address book; the network it
  uses is outbound only, which needs no entitlement.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
