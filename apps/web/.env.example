# Symplist web app (Next.js on Vercel): local development environment (architecture §2, §16.2).
# Copy to apps/web/.env. Only public values belong here: every NEXT_PUBLIC_* value is inlined
# into the browser bundle, and the web app never holds server secrets.

# The api origin (no path or trailing slash); the client calls <origin>/v1/…
NEXT_PUBLIC_API_URL=http://localhost:4000
# The api's WebSocket origin (same host and port as NEXT_PUBLIC_API_URL); the client connects to /v1/ws.
NEXT_PUBLIC_WS_URL=ws://localhost:4000
# PostHog project ingest key (phc_…). Leave empty to disable analytics in the browser.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog ingest host, for example https://us.i.posthog.com; required when the key is set.
NEXT_PUBLIC_POSTHOG_HOST=
# Vercel build setting that enables Corepack so pnpm 12.4.2 installs dependencies (§1).
ENABLE_EXPERIMENTAL_COREPACK=1
