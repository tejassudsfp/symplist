# Symplist api (NestJS on Render): local development environment template (architecture §16).
# Copy to apps/api/.env; `pnpm dev` loads it with node --env-file-if-exists=.env.
# Empty values count as unset. Never commit .env or put real secrets in this file.
# Fill every empty secret family value (<NAME>_1) with the output of `pnpm secrets:generate`.

# --- Runtime ---------------------------------------------------------------------------------------

# development | test | production. production refuses the local drivers and the scripted model.
NODE_ENV=development
# HTTP port. Render injects its own PORT.
PORT=4000

# --- Origins (canonical scheme://host[:port], no path or trailing slash) ------------------------

# The web app origin; the only origin allowed for credentialed CORS, CSRF and WebSocket upgrades.
WEB_ORIGIN=http://localhost:3000
# This api's origin; also the OAuth issuer and the base of the MCP resource URL.
API_ORIGIN=http://localhost:4000
# The WebSocket origin of this api (same host and port as API_ORIGIN).
WS_ORIGIN=ws://localhost:4000
# The share host. It must use a different host from API_ORIGIN and WEB_ORIGIN so cookies never reach it.
ARTIFACT_ORIGIN=http://127.0.0.1:4000
# Email of the first administrator, promoted once after it verifies (§5.7). Leave empty to skip.
ADMIN_BOOTSTRAP_EMAIL=
# Proxy hops in front of the api (Express trust proxy). Required in production; measured at first deploy.
TRUST_PROXY_HOPS=0

# --- Drivers and modes ------------------------------------------------------------------------------

# d1 (Cloudflare D1 and R2) | local (SQLite file and filesystem under .local-data/).
DATA_DRIVER=local
# resend | log (prints email to the api console; development only).
EMAIL_DRIVER=log
# true runs Simon, document Git, indexing and scans in Trigger.dev; false runs them in this process.
DURABLE=false
# Master key source. Only env is available (decision A4).
KEY_PROVIDER=env

# --- Access and deferred modules -------------------------------------------------------------------

# true requires an invite or admin unlock after email verification; false admits verified accounts.
BETA_ACCESS_REQUIRED=true
# Billing is not available in this release; true is rejected at startup.
BILLING_ENABLED=false
# The paywall is not available in this release; true is rejected at startup.
PAYWALL_ENABLED=false
# AI usage limits are not available in this release; true is rejected at startup.
AI_USAGE_LIMITS_ENABLED=false

# --- Sign-in and Vault ------------------------------------------------------------------------------

# Digits in an email OTP code (6 to 8).
OTP_LENGTH=6
# Minutes an OTP challenge stays valid.
OTP_TTL_MINUTES=10
# Verification attempts allowed per OTP challenge.
OTP_MAX_ATTEMPTS=5
# Minutes of inactivity before a Vault session locks.
VAULT_IDLE_LOCK_MINUTES=5

# --- Reminders, chats and documents ---------------------------------------------------------------

# false cancels pending reminder work on sight.
REMINDERS_ENABLED=true
# false keeps reminders in-app only.
REMINDER_EMAIL_ENABLED=true
# Reminders later than this many hours are expired instead of delivered.
REMINDER_MAX_LATENESS_HOURS=24
# IANA time zone used until a user chooses one.
DEFAULT_TIMEZONE=UTC
# Hours after last activity before a quick chat is deleted.
QUICK_CHAT_TTL_HOURS=24
# Largest task document in bytes (at most 1048576).
DOC_MAX_BYTES=1048576
# Absolute private directory for temporary Git repositories. Empty uses the system temp directory.
GIT_TMP_DIR=
# Absolute directory of the DATA_DRIVER=local SQLite file (d1.sqlite) and object store (objects/), shared by
# the api and `trigger dev`. Empty uses <repo>/.local-data (gitignored).
LOCAL_DATA_DIR=

# --- Email senders ----------------------------------------------------------------------------------

# Sender for OTP and security email: an address or Display Name <address>.
EMAIL_FROM_SECURITY=Symplist <security@example.com>
# Sender for reminder email; required here while DURABLE=false.
EMAIL_FROM_REMINDERS=Symplist <reminders@example.com>

# --- AI (Simon) -----------------------------------------------------------------------------------

# false hides Simon.
AI_ENABLED=true
# fast | smart: the tier new chats start with.
AI_DEFAULT_TIER=fast
# Provider for the fast tier: openai | bedrock | vertex | together.
AI_FAST_PROVIDER=openai
# Model id for the fast tier.
AI_FAST_MODEL=gpt-5.6-luna
# Provider for the smart tier: openai | bedrock | vertex | together.
AI_SMART_PROVIDER=openai
# Model id for the smart tier.
AI_SMART_MODEL=gpt-5.6-terra
# live | scripted (the scripted test model; refused in production).
AI_PROVIDER_MODE=live
# Records allowlisted numeric run telemetry only; never prompts or content (decision D8).
AI_TELEMETRY_ENABLED=true

# AI provider credentials. The api holds them only while DURABLE=false; Simon is unavailable without them.
# OpenAI API key.
OPENAI_API_KEY=
# Amazon Bedrock region, for example us-east-1.
AWS_REGION=
# Amazon Bedrock access key id (set together with the secret access key and region).
AWS_ACCESS_KEY_ID=
# Amazon Bedrock secret access key.
AWS_SECRET_ACCESS_KEY=
# Google Vertex AI project id.
GOOGLE_VERTEX_PROJECT=
# Google Vertex AI location, for example us-central1.
GOOGLE_VERTEX_LOCATION=
# Google Vertex AI service account credentials as one line of JSON.
GOOGLE_VERTEX_CREDENTIALS_JSON=
# Together AI API key.
TOGETHER_API_KEY=

# --- Trigger.dev (required when DURABLE=true) -----------------------------------------------------

# Secret key of the Trigger.dev environment (tr_…); starts, polls and cancels runs.
TRIGGER_SECRET_KEY=
# Trigger.dev project ref (proj_…).
TRIGGER_PROJECT_REF=

# --- Cloudflare D1 and R2 (required when DATA_DRIVER=d1) ----------------------------------------

# Cloudflare account id (32 hexadecimal characters).
CLOUDFLARE_ACCOUNT_ID=
# D1 database id.
D1_DATABASE_ID=
# API token for the api's D1 lane. The worker and CI use their own tokens.
CLOUDFLARE_D1_API_TOKEN=
# R2 bucket name.
R2_BUCKET=
# R2 access key id.
R2_ACCESS_KEY_ID=
# R2 secret access key.
R2_SECRET_ACCESS_KEY=

# --- Email provider and webhooks ------------------------------------------------------------------

# Resend API key; required when EMAIL_DRIVER=resend.
RESEND_API_KEY=
# Resend webhook signing secret for /webhooks/resend.
RESEND_WEBHOOK_SECRET=

# --- Connections (Composio) -----------------------------------------------------------------------

# Composio API key; connections are unavailable without it.
COMPOSIO_API_KEY=
# Composio webhook secret for /webhooks/composio.
COMPOSIO_WEBHOOK_SECRET=

# --- Analytics (PostHog) --------------------------------------------------------------------------

# false sends nothing and hides the consent banner.
ANALYTICS_ENABLED=false
# PostHog project ingest key.
POSTHOG_PROJECT_KEY=
# PostHog ingest host, for example https://us.i.posthog.com.
POSTHOG_HOST=
# PostHog personal API key used only to delete a deleted account's analytics data.
POSTHOG_PERSONAL_API_KEY=
# Numeric PostHog project id for person deletion.
POSTHOG_PROJECT_ID=

# --- Generated secret families (pnpm secrets:generate) ------------------------------------------

# Wraps every account data key. Old versions stay until everything is re-wrapped.
CONTENT_KEK_1=
# The CONTENT_KEK version used for new wraps.
CONTENT_KEK_CURRENT=1
# Signs worker-to-api internal events and run output (same value as the worker).
INTERNAL_EVENT_SECRET_1=
# The INTERNAL_EVENT_SECRET version used for new signatures.
INTERNAL_EVENT_SECRET_CURRENT=1
# Signs one-click reminder email opt-out tokens (same value as the worker).
REMINDER_UNSUBSCRIBE_SECRET_1=
# The REMINDER_UNSUBSCRIBE_SECRET version used for new tokens.
REMINDER_UNSUBSCRIBE_SECRET_CURRENT=1
# Wraps Vault data keys for passphrase reset. api only.
VAULT_RECOVERY_KEY_1=
# The VAULT_RECOVERY_KEY version used for new wraps.
VAULT_RECOVERY_KEY_CURRENT=1
# Digests session tokens, CSRF tokens and Vault session tokens. api only.
SESSION_DIGEST_SECRET_1=
# The SESSION_DIGEST_SECRET version used for new digests.
SESSION_DIGEST_SECRET_CURRENT=1
# Digests OTP codes, OTP limit keys and deletion tombstones. api only.
OTP_DIGEST_SECRET_1=
# The OTP_DIGEST_SECRET version used for new digests.
OTP_DIGEST_SECRET_CURRENT=1
# Digests invite codes. api only.
INVITE_DIGEST_SECRET_1=
# The INVITE_DIGEST_SECRET version used for new digests.
INVITE_DIGEST_SECRET_CURRENT=1
# Digests share tokens and share password form nonces. api only.
SHARE_DIGEST_SECRET_1=
# The SHARE_DIGEST_SECRET version used for new digests.
SHARE_DIGEST_SECRET_CURRENT=1
# Digests share session tokens. api only.
SHARE_SESSION_DIGEST_SECRET_1=
# The SHARE_SESSION_DIGEST_SECRET version used for new digests.
SHARE_SESSION_DIGEST_SECRET_CURRENT=1
# Digests MCP API keys, OAuth codes and refresh tokens. api only.
MCP_TOKEN_DIGEST_SECRET_1=
# The MCP_TOKEN_DIGEST_SECRET version used for new digests.
MCP_TOKEN_DIGEST_SECRET_CURRENT=1
# Signs MCP OAuth access tokens; the JWT kid is the version. api only.
MCP_OAUTH_SIGNING_KEY_1=
# The MCP_OAUTH_SIGNING_KEY version used for new tokens.
MCP_OAUTH_SIGNING_KEY_CURRENT=1
# Fingerprints idempotent requests. api only.
IDEMPOTENCY_SECRET_1=
# The IDEMPOTENCY_SECRET version used for new fingerprints.
IDEMPOTENCY_SECRET_CURRENT=1
