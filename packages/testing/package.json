{
  "name": "@symplist/testing",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest": {
      "source": "./src/vitest-config.ts",
      "types": "./dist/vitest-config.d.ts",
      "default": "./dist/vitest-config.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/provider": "4.0.14",
    "@symplist/config": "workspace:*",
    "@symplist/contracts": "workspace:*",
    "@symplist/crypto": "workspace:*",
    "@symplist/db": "workspace:*",
    "@symplist/email": "workspace:*",
    "@symplist/storage": "workspace:*",
    "ai": "7.0.101",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "7.0.2"
  }
}
