# ==================================================================================================
# Symplist — master environment template
#
# This file is the whole map: every variable the three apps read, grouped by WHICH app reads it.
# It is documentation, not a file any app loads. The apps each read their own:
#
#     apps/api/.env      <- copy from apps/api/.env.example
#     apps/worker/.env   <- copy from apps/worker/.env.example
#     apps/web/.env      <- copy from apps/web/.env.example
#
# Those three are the authoritative templates and a test keeps them honest
# (packages/config/src/env-examples.test.ts: every variable the runtime reads and nothing else,
# every one documented, no secret values, and one shared set of family values across api and
# worker).
# `pnpm env:distribute` performs that split from ignored `.env.local`, validates every runtime and
# writes the three ignored files with mode 600. `pnpm env:check` re-validates them without values.
# This root file exists so you can see the whole surface and the placement rules in one place.
#
# --------------------------------------------------------------------------------------------------
# Placement is enforced. Putting a value in the wrong file is a startup failure, not a warning.
#
#   With DURABLE=true (production):
#     OPENAI_API_KEY, AWS_*, GOOGLE_VERTEX_*, TOGETHER_API_KEY   api REJECTS   worker requires
#     TRIGGER_SECRET_KEY                                         api requires  Trigger injects it
#     RESEND_WEBHOOK_SECRET, COMPOSIO_WEBHOOK_SECRET             api only      worker REJECTS
#     POSTHOG_PERSONAL_API_KEY                                   api only      worker REJECTS
#
#   The reason: when DURABLE=true all model and tool code runs in the worker, so the api has no
#   business holding a provider key, and the config makes that structural rather than a convention.
#
# --------------------------------------------------------------------------------------------------
# Secrets
#
#   Generate every <NAME>_1 / <NAME>_CURRENT family with:   pnpm secrets:generate
#   That emits all 12 families as 32 random bytes each, base64url. The api holds all 12. Only
#   CONTENT_KEK, INTERNAL_EVENT_SECRET and REMINDER_UNSUBSCRIBE_SECRET also belong in the worker,
#   with exactly the SAME versions and values in both runtimes. The worker rejects the other nine.
#
#   BACK UP CONTENT_KEK_1 AND VAULT_RECOVERY_KEY_1 OFFLINE, BEFORE YOU SHIP.
#   Lose CONTENT_KEK and every encrypted field in D1 and R2 is unrecoverable.
#   Lose VAULT_RECOVERY_KEY and no vault can ever be recovered.
#
#   Never commit a real value. .gitignore covers `.env` and `.env.*`; this file is the one
#   exception and it must only ever contain the placeholder defaults below.
#
# The values below are the LOCAL DEVELOPMENT defaults: DATA_DRIVER=local (SQLite and the filesystem
# under .local-data/), EMAIL_DRIVER=log, DURABLE=false. That combination needs no cloud credentials
# at all — the app runs, and the live suites skip themselves.
# ==================================================================================================

# ================================================================================================
# SHARED BY THE API AND THE WORKER  ->  apps/api/.env, apps/worker/.env
#
# Both apps read these. The secret families MUST hold identical values in both: they encrypt and
# sign each other's data, and a mismatch is not a startup error, it is ciphertext neither side can
# read.
# ================================================================================================

NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
WS_ORIGIN=ws://localhost:4000
DATA_DRIVER=local
EMAIL_DRIVER=log
DURABLE=false
KEY_PROVIDER=env
BETA_ACCESS_REQUIRED=true
BILLING_ENABLED=false
PAYWALL_ENABLED=false
AI_USAGE_LIMITS_ENABLED=false
REMINDERS_ENABLED=true
REMINDER_EMAIL_ENABLED=true
REMINDER_MAX_LATENESS_HOURS=24
DEFAULT_TIMEZONE=UTC
QUICK_CHAT_TTL_HOURS=24
DOC_MAX_BYTES=1048576
GIT_TMP_DIR=
LOCAL_DATA_DIR=
EMAIL_FROM_REMINDERS=Symplist <reminders@example.com>
AI_ENABLED=true
AI_DEFAULT_TIER=fast
AI_FAST_PROVIDER=openai
AI_FAST_MODEL=gpt-5.6-luna
AI_SMART_PROVIDER=openai
AI_SMART_MODEL=gpt-5.6-terra
AI_PROVIDER_MODE=live
AI_TELEMETRY_ENABLED=true
OPENAI_API_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=
GOOGLE_VERTEX_CREDENTIALS_JSON=
TOGETHER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
RESEND_API_KEY=
COMPOSIO_API_KEY=
ANALYTICS_ENABLED=false
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=
CONTENT_KEK_1=
CONTENT_KEK_CURRENT=1
INTERNAL_EVENT_SECRET_1=
INTERNAL_EVENT_SECRET_CURRENT=1
REMINDER_UNSUBSCRIBE_SECRET_1=
REMINDER_UNSUBSCRIBE_SECRET_CURRENT=1

# ================================================================================================
# API ONLY  ->  apps/api/.env
#
# The worker rejects these at startup. OPENAI_API_KEY and the other provider keys are api-only
# when DURABLE=false; with DURABLE=true the api rejects them instead, because all model and tool
# code runs in the worker.
# ================================================================================================

PORT=4000
ARTIFACT_ORIGIN=http://127.0.0.1:4000
ADMIN_BOOTSTRAP_EMAIL=
TRUST_PROXY_HOPS=0
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
VAULT_IDLE_LOCK_MINUTES=5
EMAIL_FROM_SECURITY=Symplist <security@example.com>
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
CLOUDFLARE_D1_API_TOKEN=
RESEND_WEBHOOK_SECRET=
COMPOSIO_WEBHOOK_SECRET=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
VAULT_RECOVERY_KEY_1=
VAULT_RECOVERY_KEY_CURRENT=1
SESSION_DIGEST_SECRET_1=
SESSION_DIGEST_SECRET_CURRENT=1
OTP_DIGEST_SECRET_1=
OTP_DIGEST_SECRET_CURRENT=1
INVITE_DIGEST_SECRET_1=
INVITE_DIGEST_SECRET_CURRENT=1
SHARE_DIGEST_SECRET_1=
SHARE_DIGEST_SECRET_CURRENT=1
SHARE_SESSION_DIGEST_SECRET_1=
SHARE_SESSION_DIGEST_SECRET_CURRENT=1
MCP_TOKEN_DIGEST_SECRET_1=
MCP_TOKEN_DIGEST_SECRET_CURRENT=1
MCP_OAUTH_SIGNING_KEY_1=
MCP_OAUTH_SIGNING_KEY_CURRENT=1
IDEMPOTENCY_SECRET_1=
IDEMPOTENCY_SECRET_CURRENT=1

# ================================================================================================
# WORKER ONLY  ->  apps/worker/.env
#
# TRIGGER_SECRET_KEY is never listed here: Trigger.dev injects it into the deployed worker itself.
# ================================================================================================

TRIGGER_AI_SDK_OTEL_AUTOREGISTER=0
CLOUDFLARE_D1_WORKER_API_TOKEN=

# ================================================================================================
# WEB ONLY  ->  apps/web/.env
#
# NEXT_PUBLIC_* values are compiled into the browser bundle. Never put a secret behind that prefix.
# ================================================================================================

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
ENABLE_EXPERIMENTAL_COREPACK=1
